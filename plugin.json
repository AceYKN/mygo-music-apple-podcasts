{
  "id": "apple-podcasts",
  "name": "Apple Podcasts",
  "version": "0.2.0-preview.2",
  "libraryRefreshSeconds": 30,
  "minAppVersion": "0.1.22",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["127.0.0.1"],
    "process": ["bin/apple-podcasts-helper.exe", "bin/apple-podcasts-helper"]
  },
  "settings": [
    {
      "key": "chromePath",
      "label": "Chrome Executable",
      "help": "Optional: full path to Google Chrome. Leave blank to detect it automatically."
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Continue Listening",
      "page": "continue",
      "icon": "podcast"
    },
    {
      "title": "Latest Episodes",
      "page": "latest",
      "icon": "calendar"
    },
    {
      "builtin": "shows",
      "title": "Following"
    },
    {
      "builtin": "liked",
      "title": "Saved Episodes"
    },
    {
      "title": "Playback and Sync",
      "page": "sync",
      "icon": "chart"
    }
  ]
}
