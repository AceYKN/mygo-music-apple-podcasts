@@ -0,0 +1,127 @@
+//go:build applepodcasts_live
+
+package player
+
+import (
+	"encoding/json"
+	"mygo-music/internal/music"
+	"mygo-music/internal/plugin"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// The real plugin resumes and updates Apple progress using MyGo's muted native player.
+func TestApplePodcastsNativeLive(t *testing.T) {
+	dir := os.Getenv("MYGO_APPLE_PLUGIN")
+	data := os.Getenv("MYGO_APPLE_DATA")
+	if dir == "" || data == "" {
+		t.Skip("set explicit plugin and private-data paths for this opt-in live test")
+	}
+	src, err := plugin.Load(dir, filepath.Dir(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer src.Close()
+	account, err := src.Account()
+	if err != nil || account == nil {
+		t.Fatal("existing login was not restored", err)
+	}
+	start, err := src.PlaybackStart("1000799666254")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if start.Position == 0 {
+		t.Skip("use an already-started free sample so the original completion state can be restored")
+	}
+	posts := make(chan func(), 128)
+	p := New(func(fn func()) { posts <- fn })
+	p.SetVolume(0)
+	p.Source = func(string) music.Source { return src }
+	p.Cache = NewCache(t.TempDir(), 32<<20)
+	defer func() {
+		p.FlushProgress(15 * time.Second)
+		p.Source = func(string) music.Source { return nil }
+		p.stop()
+		if err := src.PlaybackProgress(music.PlaybackProgress{ID: "1000799666254", Position: start.Position, Duration: 3731000, Context: start.Context, Reason: "quit", RecordedAt: time.Now().UTC().Format(time.RFC3339Nano)}); err != nil {
+			t.Errorf("cannot restore pre-test position: %v", err)
+		}
+	}()
+	track := music.Track{ID: "1000799666254", Source: src.Info().ID, Name: "Native playback test", ShowID: "979020229", Duration: 3731000}
+	p.PlayTrack([]music.Track{track}, 0)
+	until := time.After(90 * time.Second)
+	for p.Loading() {
+		select {
+		case fn := <-posts:
+			fn()
+		case <-until:
+			t.Fatal("native audio did not load")
+		}
+	}
+	if p.Err() != "" || p.out == nil || p.remote != nil {
+		t.Fatalf("native player failed: %s", p.Err())
+	}
+	if p.Position() < time.Duration(start.Position)*time.Millisecond-time.Second {
+		t.Fatalf("did not resume from cloud: %v", p.Position())
+	}
+	t.Logf("Native audio ready; cloud resume %.3f s, native position %.3f s; volume zero", float64(start.Position)/1000, p.Position().Seconds())
+	p.Seek(120 * time.Second)
+	deadline := time.After(5 * time.Second)
+	for p.seeking {
+		select {
+		case fn := <-posts:
+			fn()
+		case <-deadline:
+			t.Fatal("seek did not finish")
+		}
+	}
+	p.TogglePlay()
+	for p.out.Playing() {
+		select {
+		case fn := <-posts:
+			fn()
+		case <-time.After(5 * time.Second):
+			t.Fatal("pause did not finish")
+		}
+	}
+	p.Seek(30 * time.Second)
+	if p.Position() != 30*time.Second {
+		t.Fatalf("native backward seek at %v", p.Position())
+	}
+	if !p.FlushProgress(15 * time.Second) {
+		t.Fatal("native progress callback did not finish")
+	}
+	// Query Apple again through the plugin instead of trusting its local state.
+	confirmed, err := src.PlaybackStart(track.ID)
+	if err != nil || confirmed.Position < 29000 || confirmed.Position > 31000 {
+		t.Fatalf("cloud did not confirm 30 seconds: %+v %v", confirmed, err)
+	}
+	t.Logf("Cloud confirmed native backward seek: %d ms", confirmed.Position)
+	// Restore the position found before this opt-in test.
+	progress := music.PlaybackProgress{ID: track.ID, Position: start.Position, Duration: track.Duration, Context: start.Context, Reason: "quit", RecordedAt: time.Now().UTC().Format(time.RFC3339Nano)}
+	if err = src.PlaybackProgress(progress); err != nil {
+		t.Fatal("cannot restore pre-test position", err)
+	}
+	// Prevent deferred stop from publishing the temporary test position again.
+	p.Source = func(string) music.Source { return nil }
+	entries, err := os.ReadDir(filepath.Join(data, "sync"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if entry.Name() != account.ID+".json" {
+			continue
+		}
+		raw, err := os.ReadFile(filepath.Join(data, "sync", entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		var state struct {
+			Pending []json.RawMessage `json:"pending"`
+		}
+		if json.Unmarshal(raw, &state) != nil || len(state.Pending) != 0 {
+			t.Fatal("unconfirmed synchronization remains after live test")
+		}
+	}
+}
