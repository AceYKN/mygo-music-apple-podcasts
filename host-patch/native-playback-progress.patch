diff --git a/internal/player/progress.go b/internal/player/progress.go
new file mode 100644
index 0000000..d16ad27
--- /dev/null
+++ b/internal/player/progress.go
@@ -0,0 +1,124 @@
+package player
+
+import (
+	"log"
+	"mygo-music/internal/music"
+	"sync"
+	"time"
+)
+
+type progressNotice struct {
+	source string
+	sink   music.ProgressRecorder
+	value  music.PlaybackProgress
+}
+type progressDelivery struct {
+	mu      sync.Mutex
+	pending []progressNotice
+	idle    chan struct{}
+	running bool
+	last    *music.PlaybackProgress
+}
+
+// publishProgress runs on the main thread. Delivery is ordered off that thread;
+// a slow source keeps the newest pending intent for each track and context.
+func (p *Player) publishProgress(reason string) {
+	if p.track == nil || p.out == nil || p.remote != nil || p.loading || p.seeking {
+		return
+	}
+	src := p.sourceOf(p.track)
+	if src == nil || !src.Can("playbackProgress") {
+		return
+	}
+	sink, ok := src.(music.ProgressRecorder)
+	if !ok {
+		return
+	}
+	position := max(int64(0), p.Position().Milliseconds())
+	duration := p.Duration().Milliseconds()
+	if p.progressCompleted {
+		position = max(position, duration)
+	}
+	value := music.PlaybackProgress{ID: p.track.ID, Position: position, Duration: duration, Playing: p.playing && reason != "stop" && reason != "quit" && !p.progressCompleted, Completed: p.progressCompleted, Context: p.progressContext, Reason: reason, RecordedAt: p.now().UTC().Format(time.RFC3339Nano)}
+	last := p.progress.last
+	if reason == "quit" || last == nil || last.ID != value.ID || last.Context != value.Context || last.Position != value.Position || last.Playing != value.Playing || last.Completed != value.Completed {
+		copy := value
+		p.progress.last = &copy
+		p.progress.enqueue(progressNotice{source: src.Info().ID, sink: sink, value: value})
+	}
+	if p.playing && !p.progressTicking {
+		p.progressTicking = true
+		gen := p.gen
+		p.after(15*time.Second, func() {
+			p.post(func() {
+				if gen != p.gen {
+					return
+				}
+				p.progressTicking = false
+				if p.playing {
+					p.publishProgress("tick")
+				}
+			})
+		})
+	}
+}
+func (d *progressDelivery) enqueue(notice progressNotice) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	replaced := false
+	for i, old := range d.pending {
+		if old.source == notice.source && old.value.ID == notice.value.ID && old.value.Context == notice.value.Context {
+			d.pending[i] = notice
+			replaced = true
+			break
+		}
+	}
+	if !replaced {
+		d.pending = append(d.pending, notice)
+	}
+	if d.running {
+		return
+	}
+	d.running = true
+	d.idle = make(chan struct{})
+	go func() {
+		for {
+			d.mu.Lock()
+			if len(d.pending) == 0 {
+				d.running = false
+				close(d.idle)
+				d.mu.Unlock()
+				return
+			}
+			next := d.pending[0]
+			d.pending = d.pending[1:]
+			d.mu.Unlock()
+			if err := next.sink.PlaybackProgress(next.value); err != nil {
+				log.Printf("plugin %s: playback progress: %v", next.source, err)
+			}
+		}
+	}()
+}
+
+// FlushProgress gives the current source a final position before it is closed.
+func (p *Player) FlushProgress(timeout time.Duration) bool {
+	if p.out != nil {
+		p.out.Pause()
+		p.playing = false
+	}
+	p.publishProgress("quit")
+	p.progress.mu.Lock()
+	idle, running := p.progress.idle, p.progress.running
+	p.progress.mu.Unlock()
+	if !running {
+		return true
+	}
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	select {
+	case <-idle:
+		return true
+	case <-timer.C:
+		return false
+	}
+}
diff --git a/internal/player/progress_test.go b/internal/player/progress_test.go
new file mode 100644
index 0000000..00e3996
--- /dev/null
+++ b/internal/player/progress_test.go
@@ -0,0 +1,85 @@
+package player
+
+import (
+	"mygo-music/internal/music"
+	"testing"
+	"time"
+)
+
+type progressSource struct {
+	picky
+	start  func() (*music.PlaybackStart, error)
+	record func(music.PlaybackProgress) error
+}
+
+func (s *progressSource) Can(name string) bool {
+	return name == "playbackStart" && s.start != nil || name == "playbackProgress" && s.record != nil
+}
+func (s *progressSource) Info() music.Info {
+	return music.Info{ID: "s", Playback: music.PlaybackStream}
+}
+func (s *progressSource) PlaybackStart(string) (*music.PlaybackStart, error) { return s.start() }
+func (s *progressSource) PlaybackProgress(p music.PlaybackProgress) error    { return s.record(p) }
+
+// A restored native track resumes from fresh cloud progress instead of an old local session.
+func TestNativeCloudResumeAndManualBackwardSeek(t *testing.T) {
+	p, ch, q := pickyQueue()
+	defer p.stop()
+	src := &progressSource{picky: picky{ok: map[string]bool{"a": true}}, start: func() (*music.PlaybackStart, error) {
+		return &music.PlaybackStart{Position: 300, Context: "account"}, nil
+	}}
+	p.Source = func(string) music.Source { return src }
+	p.Restore(Session{Queue: q[:1], Order: []int{0}, At: 0, Position: 50})
+	settle(t, ch, p)
+	if p.Position() != 300*time.Millisecond || p.progressContext != "account" || p.Playing() {
+		t.Fatalf("resume at %v context %q playing %v", p.Position(), p.progressContext, p.Playing())
+	}
+	p.Seek(0)
+	if p.Position() != 0 {
+		t.Fatal("cloud resume overrode an explicit backward seek")
+	}
+}
+
+// A seek while the cloud callback is pending takes priority over its late resume position.
+func TestNativeManualSeekDuringCloudResume(t *testing.T) {
+	p, ch, q := pickyQueue()
+	defer p.stop()
+	started, release := make(chan struct{}), make(chan struct{})
+	src := &progressSource{picky: picky{ok: map[string]bool{"a": true}}, start: func() (*music.PlaybackStart, error) {
+		close(started)
+		<-release
+		return &music.PlaybackStart{Position: 300, Context: "account"}, nil
+	}}
+	p.Source = func(string) music.Source { return src }
+	p.Restore(Session{Queue: q[:1], Order: []int{0}, At: 0})
+	<-started
+	p.Seek(120 * time.Millisecond)
+	close(release)
+	settle(t, ch, p)
+	if p.Position() != 120*time.Millisecond {
+		t.Fatalf("explicit seek replaced with %v", p.Position())
+	}
+}
+
+// A slow synchronization callback cannot replace a later backward seek with an older position.
+func TestProgressDeliveryKeepsLatestBackwardIntent(t *testing.T) {
+	d := &progressDelivery{}
+	started, release := make(chan struct{}), make(chan struct{})
+	got := make(chan int64, 3)
+	src := &progressSource{record: func(p music.PlaybackProgress) error {
+		if p.Position == 100 {
+			close(started)
+			<-release
+		}
+		got <- p.Position
+		return nil
+	}}
+	d.enqueue(progressNotice{source: "s", sink: src, value: music.PlaybackProgress{ID: "1", Context: "account", Position: 100}})
+	<-started
+	d.enqueue(progressNotice{source: "s", sink: src, value: music.PlaybackProgress{ID: "1", Context: "account", Position: 120}})
+	d.enqueue(progressNotice{source: "s", sink: src, value: music.PlaybackProgress{ID: "1", Context: "account", Position: 30}})
+	close(release)
+	if first, second := <-got, <-got; first != 100 || second != 30 {
+		t.Fatalf("out of order progress %d %d", first, second)
+	}
+}
