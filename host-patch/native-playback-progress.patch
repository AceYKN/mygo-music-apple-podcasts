+// pollLibrary refreshes opted-in sources without keeping hidden windows awake.
+func (a *app) pollLibrary(now time.Time) time.Duration {
+	lib := a.library
+	if lib == nil || !lib.started || lib.src.Info().LibraryRefreshSeconds <= 0 {
+		return 0
+	}
+	interval := time.Duration(min(3600, max(15, lib.src.Info().LibraryRefreshSeconds))) * time.Second
+	if !lib.libraryPollAt.IsZero() && now.Before(lib.libraryPollAt.Add(interval)) {
+		return lib.libraryPollAt.Add(interval).Sub(now)
+	}
+	lib.libraryPollAt = now
+	if lib.can("account") {
+		a.loadAccount(lib)
+	}
+	if !lib.homeLoading && (lib.can("home") || lib.can("recent")) {
+		a.loadHome(lib)
+	}
+	if lib.can("shows") && (lib.subscribedOnce || a.route.page == pageShows) {
+		a.loadSubscribed(lib, true)
+	}
+	if a.route.src == lib.id {
+		switch a.route.page {
+		case pageBrowse, pageSection:
+			a.loadBrowse(lib, a.route.id, true)
+		case pageLiked:
+			if lib.likedPaged.loaded && !lib.likedPaged.loading && !lib.likedFresh {
+				lib.likedAt = time.Time{}
+				a.freshenLiked(lib)
+			}
+		}
+	}
+	return interval
+}
