@@ -0,0 +1,114 @@
+package app
+
+import (
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/music"
+)
+
+// Cloud follows and unfollows update the actual sidebar page without restarting.
+func TestPodcastsPollsCloudMembershipAndRefocuses(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	fake(a).caps = map[string]bool{"shows": true}
+	a.library.caps = probeCaps(fake(a))
+	fake(a).info.LibraryRefreshSeconds = 30
+	a.started = true
+	a.subscribedOnce, a.subscribedAt = true, time.Now().Add(-time.Minute)
+	a.subscribed = []music.Show{{ID: "old"}}
+	a.shows["old"] = &showData{show: &music.Show{ID: "old", Subscribed: true}}
+	cloud := []music.Show{{ID: "old"}, {ID: "new"}}
+	var calls atomic.Int32
+	fake(a).shows = func() ([]music.Show, error) { calls.Add(1); return cloud, nil }
+	tt := ui.NewTester(a.view, 1200, 800)
+	tt.Frame()
+	if err := tt.Click("Podcasts"); err != nil {
+		t.Fatal(err)
+	}
+	runPost(t, ch)
+	if len(a.subscribed) != 2 || a.subscribed[1].ID != "new" {
+		t.Fatal("cloud follow did not reach sidebar page")
+	}
+	cloud = []music.Show{{ID: "new"}}
+	tt.Advance(31 * time.Second)
+	tt.Frame()
+	runPost(t, ch)
+	if len(a.subscribed) != 1 || a.subscribed[0].ID != "new" || a.shows["old"].show.Subscribed {
+		t.Fatal("cloud unfollow left stale membership")
+	}
+	before := calls.Load()
+	tt.SetWindowActive(false)
+	tt.Advance(31 * time.Second)
+	tt.Frame()
+	if calls.Load() != before {
+		t.Fatal("hidden window kept polling")
+	}
+	cloud = []music.Show{{ID: "other"}}
+	tt.SetWindowActive(true)
+	tt.Frame()
+	runPost(t, ch)
+	if len(a.subscribed) != 1 || a.subscribed[0].ID != "other" {
+		t.Fatal("refocus did not read current account membership")
+	}
+}
+
+// An old in-flight response cannot clear a newer account's load or list.
+func TestSubscribedRejectsForgottenResponseAndCoalesces(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	entered, release := make(chan struct{}), make(chan struct{})
+	secondEntered, secondRelease := make(chan struct{}), make(chan struct{})
+	var calls atomic.Int32
+	fake(a).shows = func() ([]music.Show, error) {
+		if calls.Add(1) == 1 {
+			close(entered)
+			<-release
+			return []music.Show{{ID: "old-account"}}, nil
+		}
+		close(secondEntered)
+		<-secondRelease
+		return []music.Show{{ID: "current-account"}}, nil
+	}
+	a.loadSubscribed(a.library, true)
+	<-entered
+	a.loadSubscribed(a.library, true)
+	if calls.Load() != 1 {
+		t.Fatal("duplicate in-flight list read")
+	}
+	a.library.forget()
+	a.loadSubscribed(a.library, true)
+	<-secondEntered
+	close(release)
+	runPost(t, ch)
+	if !a.subscribedBusy || len(a.subscribed) != 0 {
+		t.Fatal("old account response changed current state")
+	}
+	close(secondRelease)
+	runPost(t, ch)
+	if len(a.subscribed) != 1 || a.subscribed[0].ID != "current-account" {
+		t.Fatal("new account list was lost")
+	}
+}
+
+// Refresh failures keep the confirmed list and recover on a later successful read.
+func TestSubscribedRefreshFailurePreservesConfirmedMembership(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	a.subscribed, a.subscribedOnce = []music.Show{{ID: "confirmed"}}, true
+	fake(a).shows = func() ([]music.Show, error) { return nil, errors.New("network filtered") }
+	a.loadSubscribed(a.library, true)
+	runPost(t, ch)
+	if len(a.subscribed) != 1 || a.subscribedErr == "" {
+		t.Fatal("failed refresh erased confirmed data or hid its error")
+	}
+	fake(a).shows = func() ([]music.Show, error) { return []music.Show{}, nil }
+	a.loadSubscribed(a.library, true)
+	runPost(t, ch)
+	if len(a.subscribed) != 0 || a.subscribedErr != "" {
+		t.Fatal("healthy empty cloud list was ignored")
+	}
+}
